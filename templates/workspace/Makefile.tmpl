# Root Makefile — marker-based orchestration for every supported stack variant.

PROJECT := [[.Name]]
BACKEND_DIR := backend
WEB_DIR := web
APP_DIR := app

BACKEND_EXISTS = test -f "$(BACKEND_DIR)/go.mod" || test -f "$(BACKEND_DIR)/pyproject.toml" || test -f "$(BACKEND_DIR)/package.json" || test -f "$(BACKEND_DIR)/pom.xml"
WEB_EXISTS = test -f "$(WEB_DIR)/package.json" || test -f "$(WEB_DIR)/angular.json"
APP_EXISTS = test -f "$(APP_DIR)/pubspec.yaml" || test -f "$(APP_DIR)/package.json" || test -f "$(APP_DIR)/Package.swift" || test -f "$(APP_DIR)/build.gradle.kts" || test -f "$(APP_DIR)/build.gradle"

.PHONY: help status setup doctor dev run build test
.PHONY: backend.setup backend.run backend.build backend.test backend.doctor
.PHONY: web.install web.dev web.build web.test web.doctor
.PHONY: app.get app.run app.build app.test app.verify app.doctor

help: ## Show available targets
	@echo "Workspace: $(PROJECT)"
	@echo ""
	@awk 'BEGIN {FS = ":.*## "}; /^[a-zA-Z0-9_.-]+:.*## / {printf "  %-18s %s\n", $$1, $$2}' $(MAKEFILE_LIST)
	@echo ""
	@$(MAKE) -s status

status: ## List installed stacks and detected marker families
	@if [ -f "$(BACKEND_DIR)/go.mod" ]; then echo "  backend  yes  (go)"; \
	elif [ -f "$(BACKEND_DIR)/pyproject.toml" ]; then echo "  backend  yes  (python)"; \
	elif [ -f "$(BACKEND_DIR)/package.json" ]; then echo "  backend  yes  (node)"; \
	elif [ -f "$(BACKEND_DIR)/pom.xml" ]; then echo "  backend  yes  (java)"; \
	else echo "  backend  no   (arlox add --backend)"; fi
	@if [ -f "$(WEB_DIR)/angular.json" ]; then echo "  web      yes  (angular)"; \
	elif [ -f "$(WEB_DIR)/package.json" ]; then echo "  web      yes  (package)"; \
	else echo "  web      no   (arlox add --web)"; fi
	@if [ -f "$(APP_DIR)/pubspec.yaml" ]; then echo "  app      yes  (flutter)"; \
	elif [ -f "$(APP_DIR)/package.json" ]; then echo "  app      yes  (react-pwa)"; \
	elif [ -f "$(APP_DIR)/Package.swift" ]; then echo "  app      yes  (swift-package)"; \
	elif [ -f "$(APP_DIR)/build.gradle.kts" ] || [ -f "$(APP_DIR)/build.gradle" ]; then echo "  app      yes  (android-gradle)"; \
	else echo "  app      no   (arlox add --app)"; fi

setup: ## Install dependencies for all present stacks
	@if $(BACKEND_EXISTS); then $(MAKE) backend.setup; else echo "skip backend (not in workspace)"; fi
	@if $(WEB_EXISTS); then $(MAKE) web.install; else echo "skip web (not in workspace)"; fi
	@if $(APP_EXISTS); then $(MAKE) app.get; else echo "skip app (not in workspace)"; fi

run: ## Run present server stack(s), or the app when no web exists
	@set -e; backend_pid=""; \
	if $(BACKEND_EXISTS); then $(MAKE) backend.run & backend_pid=$$!; fi; \
	trap 'test -z "$$backend_pid" || kill "$$backend_pid" 2>/dev/null || true' EXIT INT TERM; \
	if $(WEB_EXISTS); then $(MAKE) web.dev; \
	elif $(APP_EXISTS); then $(MAKE) app.run; \
	elif [ -n "$$backend_pid" ]; then wait "$$backend_pid"; \
	else echo "nothing to run — add a stack with: arlox add"; exit 1; fi

dev: run ## Alias for run

build: ## Build all present stacks
	@if $(BACKEND_EXISTS); then $(MAKE) backend.build; else echo "skip backend (not in workspace)"; fi
	@if $(WEB_EXISTS); then $(MAKE) web.build; else echo "skip web (not in workspace)"; fi
	@if $(APP_EXISTS); then $(MAKE) app.build; else echo "skip app (not in workspace)"; fi

test: ## Test all present stacks
	@if $(BACKEND_EXISTS); then $(MAKE) backend.test; else echo "skip backend (not in workspace)"; fi
	@if $(WEB_EXISTS); then $(MAKE) web.test; else echo "skip web (not in workspace)"; fi
	@if $(APP_EXISTS); then $(MAKE) app.test; else echo "skip app (not in workspace)"; fi

doctor: ## Check the toolchain required by each present stack
	@if $(BACKEND_EXISTS); then $(MAKE) backend.doctor; else echo "backend: not in workspace"; fi
	@if $(WEB_EXISTS); then $(MAKE) web.doctor; else echo "web: not in workspace"; fi
	@if $(APP_EXISTS); then $(MAKE) app.doctor; else echo "app: not in workspace"; fi

backend.setup: ## Backend: install dependencies
	@if [ -f "$(BACKEND_DIR)/go.mod" ]; then \
		if [ -f "$(BACKEND_DIR)/Makefile" ]; then $(MAKE) -C "$(BACKEND_DIR)" setup; else cd "$(BACKEND_DIR)" && go mod download; fi; \
	elif [ -f "$(BACKEND_DIR)/pyproject.toml" ]; then \
		cd "$(BACKEND_DIR)" && uv sync --extra dev; \
	elif [ -f "$(BACKEND_DIR)/package.json" ]; then cd "$(BACKEND_DIR)" && npm install; \
	elif [ -f "$(BACKEND_DIR)/pom.xml" ]; then cd "$(BACKEND_DIR)" && if [ -x ./mvnw ]; then ./mvnw dependency:go-offline; else mvn dependency:go-offline; fi; \
	else echo "backend marker not found"; exit 1; fi

backend.run: ## Backend: run development server
	@if [ -f "$(BACKEND_DIR)/go.mod" ]; then \
		if [ -f "$(BACKEND_DIR)/Makefile" ]; then $(MAKE) -C "$(BACKEND_DIR)" run; else cd "$(BACKEND_DIR)" && go run ./cmd/server; fi; \
	elif [ -f "$(BACKEND_DIR)/pyproject.toml" ]; then cd "$(BACKEND_DIR)" && uv run uvicorn app.main:app --reload; \
	elif [ -f "$(BACKEND_DIR)/package.json" ]; then cd "$(BACKEND_DIR)" && npm run dev; \
	elif [ -f "$(BACKEND_DIR)/pom.xml" ]; then cd "$(BACKEND_DIR)" && if [ -x ./mvnw ]; then ./mvnw spring-boot:run; else mvn spring-boot:run; fi; \
	else echo "backend marker not found"; exit 1; fi

backend.build: ## Backend: build or compile
	@if [ -f "$(BACKEND_DIR)/go.mod" ]; then \
		if [ -f "$(BACKEND_DIR)/Makefile" ]; then $(MAKE) -C "$(BACKEND_DIR)" build; else cd "$(BACKEND_DIR)" && go build ./...; fi; \
	elif [ -f "$(BACKEND_DIR)/pyproject.toml" ]; then cd "$(BACKEND_DIR)" && uv run python -m compileall -q app; \
	elif [ -f "$(BACKEND_DIR)/package.json" ]; then cd "$(BACKEND_DIR)" && npm run build; \
	elif [ -f "$(BACKEND_DIR)/pom.xml" ]; then cd "$(BACKEND_DIR)" && if [ -x ./mvnw ]; then ./mvnw -DskipTests package; else mvn -DskipTests package; fi; \
	else echo "backend marker not found"; exit 1; fi

backend.test: ## Backend: run unit tests
	@if [ -f "$(BACKEND_DIR)/go.mod" ]; then cd "$(BACKEND_DIR)" && go test ./...; \
	elif [ -f "$(BACKEND_DIR)/pyproject.toml" ]; then cd "$(BACKEND_DIR)" && uv run pytest; \
	elif [ -f "$(BACKEND_DIR)/package.json" ]; then cd "$(BACKEND_DIR)" && npm test; \
	elif [ -f "$(BACKEND_DIR)/pom.xml" ]; then cd "$(BACKEND_DIR)" && if [ -x ./mvnw ]; then ./mvnw test; else mvn test; fi; \
	else echo "backend marker not found"; exit 1; fi

backend.doctor: ## Backend: report required toolchain
	@if [ -f "$(BACKEND_DIR)/go.mod" ]; then command -v go; \
	elif [ -f "$(BACKEND_DIR)/pyproject.toml" ]; then command -v uv; \
	elif [ -f "$(BACKEND_DIR)/package.json" ]; then command -v node && command -v npm; \
	elif [ -f "$(BACKEND_DIR)/pom.xml" ]; then command -v java && { [ -x "$(BACKEND_DIR)/mvnw" ] || command -v mvn; }; \
	else echo "backend marker not found"; exit 1; fi

web.install: ## Web: install package dependencies
	@$(WEB_EXISTS) || { echo "web marker not found"; exit 1; }
	@cd "$(WEB_DIR)" && npm install
	@if [ ! -f "$(WEB_DIR)/.env" ] && [ -f "$(WEB_DIR)/.env.example" ]; then cp "$(WEB_DIR)/.env.example" "$(WEB_DIR)/.env"; fi

web.dev: ## Web: run package dev script
	@$(WEB_EXISTS) || { echo "web marker not found"; exit 1; }
	@cd "$(WEB_DIR)" && npm run dev

web.build: ## Web: run package build script
	@$(WEB_EXISTS) || { echo "web marker not found"; exit 1; }
	@cd "$(WEB_DIR)" && npm run build

web.test: ## Web: run tests when the package defines them
	@$(WEB_EXISTS) || { echo "web marker not found"; exit 1; }
	@cd "$(WEB_DIR)" && if npm pkg get scripts.test | grep -vq '^{}$$'; then npm test; else echo "skip web tests (no test script)"; fi

web.doctor: ## Web: report Node toolchain
	@$(WEB_EXISTS) || { echo "web marker not found"; exit 1; }
	@command -v node && command -v npm

app.get: ## App: install or resolve dependencies
	@if [ -f "$(APP_DIR)/pubspec.yaml" ]; then cd "$(APP_DIR)" && flutter pub get; \
	elif [ -f "$(APP_DIR)/package.json" ]; then cd "$(APP_DIR)" && npm install; \
	elif [ -f "$(APP_DIR)/Package.swift" ]; then cd "$(APP_DIR)" && swift package resolve; \
	elif [ -f "$(APP_DIR)/build.gradle.kts" ] || [ -f "$(APP_DIR)/build.gradle" ]; then cd "$(APP_DIR)" && if [ -x ./gradlew ]; then ./gradlew tasks >/dev/null; else gradle tasks >/dev/null; fi; \
	else echo "app marker not found"; exit 1; fi

app.run: ## App: run interactively
	@if [ -f "$(APP_DIR)/pubspec.yaml" ]; then cd "$(APP_DIR)" && flutter run; \
	elif [ -f "$(APP_DIR)/package.json" ]; then cd "$(APP_DIR)" && npm run dev; \
	elif [ -f "$(APP_DIR)/Package.swift" ]; then cd "$(APP_DIR)" && swift run; \
	elif [ -f "$(APP_DIR)/build.gradle.kts" ] || [ -f "$(APP_DIR)/build.gradle" ]; then cd "$(APP_DIR)" && if [ -x ./gradlew ]; then ./gradlew installDebug; else gradle installDebug; fi; \
	else echo "app marker not found"; exit 1; fi

app.build: ## App: build the installed variant
	@if [ -f "$(APP_DIR)/pubspec.yaml" ]; then cd "$(APP_DIR)" && flutter build web; \
	elif [ -f "$(APP_DIR)/package.json" ]; then cd "$(APP_DIR)" && npm run build; \
	elif [ -f "$(APP_DIR)/Package.swift" ]; then cd "$(APP_DIR)" && swift build; \
	elif [ -f "$(APP_DIR)/build.gradle.kts" ] || [ -f "$(APP_DIR)/build.gradle" ]; then cd "$(APP_DIR)" && if [ -x ./gradlew ]; then ./gradlew assembleDebug; else gradle assembleDebug; fi; \
	else echo "app marker not found"; exit 1; fi

app.test: ## App: run unit tests
	@if [ -f "$(APP_DIR)/pubspec.yaml" ]; then cd "$(APP_DIR)" && flutter test; \
	elif [ -f "$(APP_DIR)/package.json" ]; then cd "$(APP_DIR)" && npm test; \
	elif [ -f "$(APP_DIR)/Package.swift" ]; then cd "$(APP_DIR)" && swift test; \
	elif [ -f "$(APP_DIR)/build.gradle.kts" ] || [ -f "$(APP_DIR)/build.gradle" ]; then cd "$(APP_DIR)" && if [ -x ./gradlew ]; then ./gradlew test; else gradle test; fi; \
	else echo "app marker not found"; exit 1; fi

app.verify: ## App: standardized static checks and tests
	@if [ -f "$(APP_DIR)/pubspec.yaml" ]; then cd "$(APP_DIR)" && flutter analyze && flutter test; \
	elif [ -f "$(APP_DIR)/package.json" ]; then cd "$(APP_DIR)" && npm test && npm run build; \
	elif [ -f "$(APP_DIR)/Package.swift" ]; then cd "$(APP_DIR)" && swift build && swift test; \
	elif [ -f "$(APP_DIR)/build.gradle.kts" ] || [ -f "$(APP_DIR)/build.gradle" ]; then cd "$(APP_DIR)" && if [ -x ./gradlew ]; then ./gradlew test lint assembleDebug; else gradle test lint assembleDebug; fi; \
	else echo "app marker not found"; exit 1; fi

app.doctor: ## App: report required toolchain
	@if [ -f "$(APP_DIR)/pubspec.yaml" ]; then command -v flutter; \
	elif [ -f "$(APP_DIR)/package.json" ]; then command -v node && command -v npm; \
	elif [ -f "$(APP_DIR)/Package.swift" ]; then command -v swift; \
	elif [ -f "$(APP_DIR)/build.gradle.kts" ] || [ -f "$(APP_DIR)/build.gradle" ]; then [ -x "$(APP_DIR)/gradlew" ] || command -v gradle; \
	else echo "app marker not found"; exit 1; fi
