package middleware

import (
	"net/http"
	"strings"

	"github.com/gin-gonic/gin"

	"[[.Module]]/internal/authjwt"
	"[[.Module]]/internal/response"
)

const ClaimsKey = "claims"

func Auth(jwtSecret string) gin.HandlerFunc {
	return func(c *gin.Context) {
		header := c.GetHeader("Authorization")
		if !strings.HasPrefix(header, "Bearer ") {
			response.Err(c, http.StatusUnauthorized, "missing bearer token")
			return
		}
		claims, err := authjwt.Verify(strings.TrimPrefix(header, "Bearer "), jwtSecret)
		if err != nil {
			response.Err(c, http.StatusUnauthorized, "invalid token")
			return
		}
		c.Set(ClaimsKey, claims)
		c.Next()
	}
}
