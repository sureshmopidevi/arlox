package server

import (
	"net/http"

	"github.com/gin-gonic/gin"
	"go.uber.org/zap"

	"[[.Module]]/internal/config"
	"[[.Module]]/internal/middleware"
	authHandler "[[.Module]]/modules/auth/handler"
	authRoutes "[[.Module]]/modules/auth/routes"
	pingHandler "[[.Module]]/modules/ping/handler"
	pingRoutes "[[.Module]]/modules/ping/routes"
)

func NewRouter(
	cfg *config.Config,
	log *zap.Logger,
	ping *pingHandler.Handler,
	auth *authHandler.Handler,
) *gin.Engine {
	if cfg.ServerEnv == "production" {
		gin.SetMode(gin.ReleaseMode)
	}

	r := gin.New()
	r.Use(middleware.Logger(log), middleware.Recovery(log))

	// health
	r.GET("/health/live", func(c *gin.Context) { c.JSON(http.StatusOK, gin.H{"status": "ok"}) })
	r.GET("/health/ready", func(c *gin.Context) { c.JSON(http.StatusOK, gin.H{"status": "ok"}) })

	api := r.Group("/api/v1")
	authMw := middleware.Auth(cfg.JWTSecret)

	pingRoutes.Register(api, ping)
	authRoutes.Register(api, auth, authMw)

	return r
}
